# Base de datos (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Launch Library 2 (en desarrollo puede usarse https://lldev.thespacedevs.com/2.3.0 solo para inspeccionar; nunca guardar sus datos)
LL2_BASE_URL="https://ll.thespacedevs.com/2.3.0"
LL2_MAX_REQUESTS_PER_HOUR=14
LL2_RESERVE=6

# Revalidación y cron
REVALIDATE_SECRET=""
CRON_SECRET=""
SITE_URL="https://net-launch.vercel.app"

# Traducción (Gemini, capa gratuita)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_MAX_REQUESTS=6

# Opcionales
NEXT_PUBLIC_MAPTILER_KEY=""
